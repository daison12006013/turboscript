	"item": [
		{
			"name": "Setup",
			"item": [
				{
					"name": "Initialize Variables",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Generate a unique email for this test run",
									"const randomSuffix = Math.random().toString(36).substring(2, 8);",
									"const testEmail = `test.user.${randomSuffix}@turboscript.test`;",
									"",
									"// Store in collection variables for reuse across all requests",
									"pm.collectionVariables.set('testEmail', testEmail);",
									"pm.collectionVariables.set('testName', `Test User ${randomSuffix.toUpperCase()}`);",
									"pm.collectionVariables.set('testPassword', 'MyComplexP@ssw0rd2024!');",
									"pm.collectionVariables.set('baseUrl', 'http://127.0.0.1:7890');",
									"",
									"console.log(`Generated test email: ${testEmail}`);",
									"console.log(`Generated test name: Test User ${randomSuffix.toUpperCase()}`);",
									"",
									"// Clear any existing auth tokens",
									"pm.collectionVariables.unset('accessToken');",
									"pm.collectionVariables.unset('refreshToken');",
									"pm.collectionVariables.unset('userUid');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								""
							]
						},
						"description": "Initialize test variables and check if the server is running"
					},
					"response": []
				}
			],
			"description": "Setup collection variables and test environment"
		},
