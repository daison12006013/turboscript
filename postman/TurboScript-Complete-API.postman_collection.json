		{
			"name": "2. Create User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('User created successfully', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson).to.have.property('status');",
							"    pm.expect(responseJson.status).to.eql('success');",
							"    pm.expect(responseJson).to.have.property('data');",
							"    pm.expect(responseJson.data).to.have.property('uid');",
							"    ",
							"    // Store user UID for later use",
							"    pm.collectionVariables.set('userUid', responseJson.data.uid);",
							"    console.log(`Created user with UID: ${responseJson.data.uid}`);",
							"});",
							"",
							"pm.test('User data matches input', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.data.name).to.eql(pm.collectionVariables.get('testName'));",
							"    pm.expect(responseJson.data.email).to.eql(pm.collectionVariables.get('testEmail'));",
							"});",
							"",
							"pm.test('Response time is acceptable', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"{{testName}}\",\n    \"email\": \"{{testEmail}}\",\n    \"password\": \"{{testPassword}}\",\n    \"confirm_password\": \"{{testPassword}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users"
					]
				},
				"description": "Create a new user with generated email and password"
			},
			"response": []
		},
		{
			"name": "3. User Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",					"pm.test('Login successful', function () {",
					"    const responseJson = pm.response.json();",
					"    pm.expect(responseJson).to.have.property('status');",
					"    pm.expect(responseJson.status).to.eql('success');",
					"    pm.expect(responseJson).to.have.property('data');",
					"    pm.expect(responseJson.data).to.have.property('access_token');",
					"    pm.expect(responseJson.data).to.have.property('refresh_token');",
					"    ",
					"    // Store tokens for authenticated requests",
					"    pm.collectionVariables.set('accessToken', responseJson.data.access_token);",
					"    pm.collectionVariables.set('refreshToken', responseJson.data.refresh_token);",
					"    ",
					"    console.log('Login successful, tokens stored');",
					"});",
							"",
							"pm.test('User data is returned', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.data.email).to.eql(pm.collectionVariables.get('testEmail'));",
							"    pm.expect(responseJson.data).to.have.property('uid');",
							"    pm.expect(responseJson.data).to.have.property('name');",
							"});",
							"",
							"pm.test('Token expiration dates are provided', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.data).to.have.property('access_token_expires_at');",
							"    pm.expect(responseJson.data).to.have.property('refresh_token_expires_at');",
							"});",
							"",
							"pm.test('Password rehash indicator is present', function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.data).to.have.property('password_needs_rehash');",
							"    pm.expect(typeof responseJson.data.password_needs_rehash).to.eql('boolean');",
							"});",
							"",
							"pm.test('Response time is acceptable', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
