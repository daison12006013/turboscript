# GitHub Self-Hosted Runner Environment Configuration

# REQUIRED: GitHub Authentication
# Get a Personal Access Token from: https://github.com/settings/tokens
# Required scopes: repo, workflow, admin:repo_hook
GITHUB_TOKEN=your_github_personal_access_token_here

# REQUIRED: Repository Information
# Format: owner/repository
GITHUB_REPOSITORY=daison12006013/turboscript

# OPTIONAL: Runner Configuration
# Customize the runner name (default: turboscript-docker-runner)
RUNNER_NAME=turboscript-local-runner

# Customize runner labels (comma-separated)
RUNNER_LABELS=self-hosted,linux,docker,turboscript,local,dev

# Runner group (default: default)
RUNNER_GROUP=default

# OPTIONAL: CI Environment Variables
# Override Go version if needed
GO_VERSION=1.23.0

# Override PostgreSQL version if needed
POSTGRES_VERSION=16

# Set Node environment
NODE_ENV=test

# Enable CI mode
CI=true

# OPTIONAL: Performance Settings
# Adjust Docker resources if needed
# DOCKER_CPU_LIMIT=2
# DOCKER_MEMORY_LIMIT=4g

# OPTIONAL: Database Configuration for Local CI
# PostgreSQL settings for CI testing
POSTGRES_USER=turboscript_user
POSTGRES_PASSWORD=turboscript_pass
POSTGRES_DB=turboscript

# OPTIONAL: Security Settings
# Set to true to enable additional security scanning in CI
ENABLE_SECURITY_SCAN=true

# Set to true to enable performance testing
ENABLE_PERFORMANCE_TESTS=true

# OPTIONAL: Notification Settings
# Slack webhook for CI notifications (optional)
# SLACK_WEBHOOK_URL=

# Email for CI notifications (optional)
# CI_NOTIFICATION_EMAIL=
